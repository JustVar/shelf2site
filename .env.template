# =============================================================================
# Shelf2Site configuration
# =============================================================================
# Copy this file to .env and fill in the three values marked GENERATE.
# .env is ignored by git; never commit it. The app refuses to start while a
# secret is missing or still says GENERATE.

# --- Database ---------------------------------------------------------------
# docker-compose.yml builds DATABASE_URL from this password.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=GENERATE

# Running without Docker? Set the full URL instead, for example:
# DATABASE_URL=postgresql://asset_tracker_user:PASSWORD@localhost:5432/asset_tracker

# --- Secrets ----------------------------------------------------------------
# Encrypts stored device credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=GENERATE

# Signs session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=GENERATE

# --- URLs -------------------------------------------------------------------
# The address people reach the app at; used for absolute links in messages.
APP_BASE_URL=http://localhost:8081

# Set ROOT_PATH when a reverse proxy serves the app under a sub-path.
# ROOT_PATH=/shelf2site

# Set to true once the app is served over HTTPS, so session cookies are
# only sent over HTTPS.
HTTPS_ONLY=false

# Reverse proxies whose X-Forwarded-For header is trusted for the client
# address (login limiting, audit log). The image default covers a proxy on the
# host or in Compose. List your proxy's address if it sits elsewhere.
# FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12

# --- Optional integrations --------------------------------------------------
# Each one is off while its values are blank.

# Slack alerts for new devices awaiting review.
# SLACK_WEBHOOK_URL=

# Zendesk ticket lookup during provisioning. Ticket numbers link to
# https://SUBDOMAIN.zendesk.com/agent/tickets/NUMBER.
# ZENDESK_SUBDOMAIN=
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=

# Email notifications.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Shelf2Site <noreply@example.com>

# Geocoding of site addresses for the map (Nominatim / OpenStreetMap).
# Nominatim asks for a User-Agent with contact details and at most one
# request per second.
GEOCODER_ENABLED=false
GEOCODER_USER_AGENT=Shelf2Site/1.0 (set-a-contact-address@example.com)
