# =============================================================================
# Asset Tracker - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://asset_tracker_user:YOUR_PASSWORD@db:5432/asset_tracker

# --- Credentials Vault ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=GENERATE_ME

# --- Session Secret (signed cookies for user auth) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=GENERATE_ME

# --- Scanner Configuration ---
# Mode: "local" (central host, writes to DB) or "remote" (remote agent, POSTs to central API)
SCANNER_MODE=local
SCAN_SUBNETS=192.0.2.0/24
SCAN_INTERVAL_SECONDS=120
SCANNER_ID=apphost

# --- Remote Agent Only (SCANNER_MODE=remote) ---
# CENTRAL_API_URL=http://192.0.2.10:8100/assettracker
# SCANNER_API_KEY=YOUR_SHARED_SECRET

# --- Scanner API Key (central host validates incoming from remote agents) ---
SCANNER_API_KEY=YOUR_SHARED_SECRET

# --- Reverse Proxy (set if app runs behind Nginx at a sub-path) ---
# ROOT_PATH=/assettracker

# --- Slack Webhook (optional, for pending device alerts) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Spreadsheet Import ---
SPREADSHEET_PATH=data/Inventory_Tracker_Export.xlsx

# --- App base URL (used to build absolute links in notifications) ---
# Set to the URL the app is reached at. 'db' in DATABASE_URL above is the
# Docker Compose service name (in-container); change it for non-Docker hosts.
APP_BASE_URL=http://192.0.2.10:8100/assettracker
