# =============================================================================
# Asset Tracker - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://inventory_user:YOUR_PASSWORD@localhost:5432/hardware_inventory

# --- Credentials Vault ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=GENERATE_ME

# --- Session Secret (signed cookies for user auth) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=GENERATE_ME

# --- Scanner Configuration ---
# Mode: "local" (NUC 1, writes to DB) or "remote" (NUC 2+, POSTs to central API)
SCANNER_MODE=local
SCAN_SUBNETS=192.0.2.0/24
SCAN_INTERVAL_SECONDS=120
SCANNER_ID=lab-nuc

# --- Remote Agent Only (SCANNER_MODE=remote) ---
# CENTRAL_API_URL=http://192.0.2.174:8081
# SCANNER_API_KEY=YOUR_SHARED_SECRET

# --- Scanner API Key (NUC 1 validates incoming from remote agents) ---
SCANNER_API_KEY=YOUR_SHARED_SECRET

# --- Reverse Proxy (set if app runs behind Nginx at a sub-path) ---
# ROOT_PATH=/assettracker

# --- Slack Webhook (optional, for pending device alerts) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Spreadsheet Import ---
SPREADSHEET_PATH=data/Inventory_Tracker_Export.xlsx
