# =============================================================================
# Asset Tracker - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://asset_tracker_user:YOUR_PASSWORD@db:5432/asset_tracker

# --- Credentials Vault ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=GENERATE_ME

# --- Session Secret (signed cookies for user auth) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=GENERATE_ME


# --- Reverse Proxy (set if app runs behind Nginx at a sub-path) ---
# ROOT_PATH=/assettracker

# --- Slack Webhook (optional, for pending device alerts) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- App base URL (used to build absolute links in notifications) ---
# Set to the URL the app is reached at. 'db' in DATABASE_URL above is the
# Docker Compose service name (in-container); change it for non-Docker hosts.
APP_BASE_URL=https://192.0.2.10:8443/assettracker

# Geocoding (Nominatim / OpenStreetMap default). Address -> lat/lng for the map.
# Nominatim policy: descriptive User-Agent (contact email) and >=1 req/sec.
# Set GEOCODER_ENABLED=false or blank GEOCODER_BASE_URL to disable (Fix-only).
GEOCODER_ENABLED=true
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=AssetTracker/1.0 (owner@example.com)
GEOCODER_RATE_LIMIT_S=1.1
GEOCODER_TIMEOUT_S=10
